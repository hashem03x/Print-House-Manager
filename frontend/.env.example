# Copy to .env (development) or set in your hosting provider (production).

# Base URL of the backend API, including /api.
# Leave empty in development: the app calls /api and Vite proxies it to the backend.
# Production example: https://print-house-api.onrender.com/api
VITE_API_URL=

# Development only: where the Vite dev server forwards /api requests.
VITE_DEV_PROXY_TARGET=http://localhost:5000
