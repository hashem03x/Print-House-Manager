# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on (most hosts set PORT automatically)
PORT=5000

# MongoDB connection string (local or Atlas). Include a database name (/printing-house).
# Local:  mongodb://127.0.0.1:27017/printing-house
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/printing-house?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/printing-house

# Frontend origin(s) allowed by CORS. Separate multiple origins with commas.
# Production example: https://print-house.example.com
CLIENT_URL=http://localhost:5173

# Business time zone (IANA name) used to decide what "today" means on the dashboard.
APP_TIMEZONE=Africa/Cairo

# development | production (production hides internal error details)
NODE_ENV=development
